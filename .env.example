# Copy this file to .env and fill in the values. Never share or commit .env.

# A long random string. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Web addresses the site answers on, comma-separated (production only)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# e.g. https://germanlab.example.com (production only)
DJANGO_CSRF_TRUSTED_ORIGINS=

# Database: leave POSTGRES_DB empty to use the SQLite file db.sqlite3
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Uploaded videos are stored here (default: the media folder)
# MEDIA_ROOT=
VIDEO_MAX_UPLOAD_MB=500

# Speaking answers
SPEAKING_MAX_UPLOAD_MB=20
SPEAKING_MAX_RECORD_MINUTES=10
SPEAKING_KEEP_DAYS_AFTER_FEEDBACK=3

TIME_ZONE=Europe/Berlin

# Email: printed in the server window until you set up a real email account.
# For Gmail, use an app password:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
