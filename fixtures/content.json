 "grammar": [
  {
   "level": "A1",
   "title": "Präsens: regular verbs",
   "order": 1,
   "rule": "Regular verbs follow: verb stem + ending. Remove -en from infinitive to get the stem.",
   "table": {
    "headers": [
     "Person",
     "Ending",
     "lernen"
    ],
    "rows": [
     [
      "ich",
      "-e",
      "lerne"
     ],
     [
      "du",
      "-st",
      "lernst"
     ],
     [
      "er/sie/es",
      "-t",
      "lernt"
     ],
     [
      "wir",
      "-en",
      "lernen"
     ],
     [
      "ihr",
      "-t",
      "lernt"
     ],
     [
      "Sie/sie",
      "-en",
      "lernen"
     ]
    ]
   },
   "examples": [
    {
     "de": "Ich lerne Deutsch.",
     "en": "I am learning German."
    },
    {
     "de": "Du arbeitest viel.",
     "en": "You work a lot."
    }
   ]
  },
  {
   "level": "A1",
   "title": "Artikel: der, die, das",
   "order": 2,
   "rule": "Every noun has an article: maskulin (der), feminin (die), neutral (das). You must memorise the article with each noun!",
   "table": {
    "headers": [
     "Gender",
     "Article",
     "Example"
    ],
    "rows": [
     [
      "maskulin",
      "der",
      "der Mann, der Tisch"
     ],
     [
      "feminin",
      "die",
      "die Frau, die Stadt"
     ],
     [
      "neutral",
      "das",
      "das Kind, das Haus"
     ],
     [
      "Plural",
      "die",
      "die Männer, die Frauen"
     ]
    ]
   },
   "examples": [
    {
     "de": "der Vater, die Mutter, das Kind",
     "en": "the father, the mother, the child"
    }
   ]
  },
  {
   "level": "A1",
   "title": "Verneinung: nicht and kein",
   "order": 3,
   "rule": "'nicht' negates verbs and adjectives. 'kein' negates nouns (= not a / no). kein follows the article pattern.",
   "table": {
    "headers": [
     "Word",
     "Use",
     "Example"
    ],
    "rows": [
     [
      "nicht",
      "verbs, adj.",
      "Ich schlafe nicht."
     ],
     [
      "kein/keine/kein",
      "nouns (indefinite)",
      "Ich habe keine Zeit."
     ]
    ]
   },
   "examples": [
    {
     "de": "Ich bin nicht müde.",
     "en": "I am not tired."
    },
    {
     "de": "Er hat kein Geld.",
     "en": "He has no money."
    }
   ]
  },
  {
   "level": "A2",
   "title": "Nebensätze: weil, obwohl, dass",
   "order": 4,
   "rule": "In subordinate clauses the conjugated verb goes to the END. Remember: WEIL and OBWOHL = verb to the end!",
   "table": {
    "headers": [
     "Conjunction",
     "Meaning",
     "Verb position"
    ],
    "rows": [
     [
      "weil",
      "because",
      "...weil ich müde BIN."
     ],
     [
      "obwohl",
      "although",
      "...obwohl es spät IST."
     ],
     [
      "dass",
      "that",
      "...dass du recht HAST."
     ],
     [
      "wenn",
      "when/if",
      "...wenn ich Zeit HABE."
     ]
    ]
   },
   "examples": [
    {
     "de": "Ich bleibe zu Hause, weil ich krank bin.",
     "en": "I stay home because I am sick."
    },
    {
     "de": "Er kommt, obwohl er müde ist.",
     "en": "He comes although he is tired."
    }
   ]
  },
  {
   "level": "A2",
   "title": "Perfekt: talking about the past",
   "order": 5,
   "rule": "Perfekt = haben/sein + Partizip II. Motion verbs and state-change verbs use SEIN. All others use HABEN.",
   "table": {
    "headers": [
     "Helper",
     "When",
     "Example"
    ],
    "rows": [
     [
      "haben",
      "most verbs",
      "Ich habe gegessen."
     ],
     [
      "sein",
      "motion + change",
      "Ich bin gegangen."
     ],
     [
      "sein",
      "state change",
      "Er ist eingeschlafen."
     ]
    ]
   },
   "examples": [
    {
     "de": "Ich habe gestern Sport gemacht.",
     "en": "I did sports yesterday."
    },
    {
     "de": "Wir sind nach Berlin gefahren.",
     "en": "We went to Berlin."
    }
   ]
  },
  {
   "level": "A2",
   "title": "Konjunktiv II",
   "order": 6,
   "rule": "Konjunktiv II expresses wishes, hypotheses and polite requests. Use würde + Infinitiv OR direct forms: hätte/wäre/könnte.",
   "table": {
    "headers": [
     "Verb",
     "Konj. II",
     "Example"
    ],
    "rows": [
     [
      "haben",
      "hätte",
      "Wenn ich Zeit hätte..."
     ],
     [
      "sein",
      "wäre",
      "Wenn ich reich wäre..."
     ],
     [
      "können",
      "könnte",
      "Könnten Sie helfen?"
     ],
     [
      "+ würde",
      "würde + Inf.",
      "Ich würde reisen."
     ]
    ]
   },
   "examples": [
    {
     "de": "Wenn ich Geld hätte, würde ich reisen.",
     "en": "If I had money, I would travel."
    },
    {
     "de": "Könnten Sie bitte langsamer sprechen?",
     "en": "Could you please speak more slowly?"
    }
   ]
  },
  {
   "level": "A2",
