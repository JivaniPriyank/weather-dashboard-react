      "älter",
      "am ältesten"
     ],
     [
      "gut",
      "besser",
      "am besten"
     ],
     [
      "viel",
      "mehr",
      "am meisten"
     ]
    ]
   },
   "examples": [
    {
     "de": "Berlin ist größer als München.",
     "en": "Berlin is bigger than Munich."
    },
    {
